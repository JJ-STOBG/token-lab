{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://stobg.local/schemas/accessibility-rules.schema.json",
    "title": "STOBG Accessibility Rules",
    "type": "array",
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
            "id",
            "componentId",
            "label",
            "foregroundTokenId",
            "backgroundTokenId",
            "minimumRatio",
            "classification"
        ],
        "properties": {
            "id": {
                "type": "string",
                "minLength": 1
            },
            "componentId": {
                "type": "string",
                "minLength": 1
            },
            "label": {
                "type": "string",
                "minLength": 1
            },
            "foregroundTokenId": {
                "type": "string",
                "minLength": 1
            },
            "backgroundTokenId": {
                "type": "string",
                "minLength": 1
            },
            "minimumRatio": {
                "type": "number",
                "exclusiveMinimum": 0
            },
            "classification": {
                "enum": [
                    "normal-text",
                    "large-text",
                    "ui-component",
                    "graphic"
                ]
            }
        }
    }
}