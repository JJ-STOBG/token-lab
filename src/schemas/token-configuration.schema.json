{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://stobg.local/schemas/token-configuration.schema.json",
    "title": "STOBG Token Configuration",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "configurationId",
        "version",
        "primitives",
        "semanticTokens"
    ],
    "properties": {
        "schemaVersion": {
            "type": "string",
            "minLength": 1
        },
        "configurationId": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "primitives": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/primitive"
            }
        },
        "semanticTokens": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/semantic"
            }
        }
    },
    "$defs": {
        "primitive": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "group",
                "value",
                "label"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "const": "primitive"
                },
                "group": {
                    "type": "string",
                    "minLength": 1
                },
                "value": {
                    "type": "string",
                    "pattern": "^#[0-9A-F]{6}$"
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "semantic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "category",
                "mapsTo",
                "label",
                "description"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "const": "semantic"
                },
                "category": {
                    "type": "string",
                    "minLength": 1
                },
                "mapsTo": {
                    "type": "string",
                    "minLength": 1
                },
                "label": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "allowedPrimitiveGroups": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "uniqueItems": true
                }
            }
        }
    }
}